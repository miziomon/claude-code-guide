# URL base del sito WordPress (senza slash finale)
WP_BASE_URL=https://miosito.example.com

# Nome utente WordPress (deve avere permessi di pubblicazione)
WP_USERNAME=maurizio

# Application Password generata da: Utente → Modifica profilo → Application Passwords
# Formato: xxxx xxxx xxxx xxxx xxxx xxxx (24 caratteri con spazi)
# È separata dalla password principale e si revoca senza cambiare la password vera.
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
